# Copy to .env and fill in from Supabase → Project Settings → API.
# Both values are public by design (they ship inside the app); row level security protects the data.
# Never put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
